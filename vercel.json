{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/music/(.*)", "dest": "/music/$1" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
